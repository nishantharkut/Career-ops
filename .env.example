# Required. Set both in a private .env file before using Docker Compose.
CAREEROPS_AUTH_USERNAME=
CAREEROPS_AUTH_PASSWORD=

# Host and process ownership.
CAREEROPS_PORT=8765
CAREEROPS_UID=1000
CAREEROPS_GID=1000
CAREEROPS_ALLOWED_ORIGINS=

# Providers are explicit and never fall back to another identity.
CAREEROPS_CODEX_ENABLED=false
CAREEROPS_CODEX_COMMANDS=codex2,codex
CAREEROPS_OLLAMA_MODEL=qwen2.5:7b
CAREEROPS_OLLAMA_IMAGE=ollama/ollama@sha256:6345fbc18bd73a1e16404be681dbc6fd291a027cab43ed541abe78c4c81051b0
